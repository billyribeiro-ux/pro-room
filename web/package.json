{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:env": "bash ../scripts/ensure-dev-env.sh",
		"dev:infra": "docker compose -f ../compose.yaml up -d --wait postgres redis",
		"dev:api": "cd ../server && cargo run -q -p server",
		"dev:backend": "pnpm run dev:infra && pnpm run dev:api",
		"dev:wait-api": "bash ../scripts/wait-for-api.sh",
		"dev:web": "pnpm run dev:wait-api && pnpm run dev",
		"dev:all": "pnpm run dev:env && concurrently -k -n api,web -c yellow,cyan \"pnpm run dev:backend\" \"pnpm run dev:web\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
		"concurrently": "^10.0.3",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fontsource/open-sans": "^5.3.0",
		"@fortawesome/fontawesome-free": "7.3.1",
		"dompurify": "^3.4.12",
		"valibot": "^1.4.2"
	},
	"engines": {
		"node": ">=24.18.0"
	},
	"packageManager": "pnpm@11.15.0"
}
